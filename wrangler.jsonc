{
  "name": "cotiza-demo",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cotiza-demo-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
